/* style_light.qss – Tema claro */

QMainWindow {
    background-color: #f5f5f5;   /* gris muy claro */
    color: #2b2b2b;
}

QListWidget {
    background-color: #ffffff;
    color: #2b2b2b;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 4px;
    outline: none;
}
QListWidget::item {
    padding: 6px;
    border-bottom: 1px solid #e0e0e0;
}
QListWidget::item:selected {
    background-color: #4a6fa5;   /* mismo azul apagado */
    color: #ffffff;
}
QListWidget::item:hover {
    background-color: #e8e8e8;
}

QPushButton {
    background-color: #f5f5f5;
    color: #2b2b2b;
    border: none;
    border-radius: 6px;
    padding: 8px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #b3d0e5;   /* azul claro */
}
QPushButton:pressed {
    background-color: #89b3d1;   /* azul más intenso */
}
QPushButton:checked {
    background-color: #4a9ec8;   /* azul brillante */
    color: #ffffff;
}

QSlider::groove:horizontal {
    background: #cccccc;
    border-radius: 4px;
}
QSlider::handle:horizontal {
    background: #4a6fa5;          /* azul apagado */
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}
QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #1e90ff,
                                stop:0.5 #00bfff,
                                stop:1 #00fa9a);
    border-radius: 4px;
}
QSlider::handle:horizontal:focus {
    border: 1px solid #4a9ec8;
}

QLabel#lbl_track_info {
    font-size: 16px;
    font-weight: bold;
    color: #2b4b6f;               /* azul oscuro */
    padding: 4px;
}

QLabel#lbl_cover {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 6px;
    color: #4a9ec8;
    font-size: 48px;
    qproperty-alignment: AlignCenter;
}
